# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Server
PORT=3000

# Chroma (local vector database)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=linguabridge_docs

# RAG tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
RELEVANCE_SCORE_THRESHOLD=0.48

# LLM generation
# n8n Automation
N8N_WEBHOOK_URL=http://localhost:5678/webhook/linguabridge-query
