# Server
PORT=3000

# Groq (Cloud LLM - Ultra-alta Velocidad LPU - Modelo 120B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (Cloud LLM Secundario)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# Ollama Local (Fallback automático)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b


OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest

# PostgreSQL + pgvector (Base de datos vectorial)
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=linguabridge
PG_USER=postgres
PG_PASSWORD=postgres


# RAG Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=6
RELEVANCE_SCORE_THRESHOLD=0.25
LLM_TEMPERATURE=0

# n8n Automation
N8N_WEBHOOK_URL=http://localhost:5678/webhook/linguabridge-query

# Telegram Real-Time Live Chat
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADVISOR_CHAT_ID=your_telegram_chat_id_here

