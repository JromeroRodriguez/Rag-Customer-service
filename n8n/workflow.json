            "type": "main",
            "index": 0
          },
          {
            "node": "Respond - Escalated to Advisor",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond - Answered by Lingua",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
